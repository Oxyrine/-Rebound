flowchart TB
    IN["Failed-payment event + customer reply<br/><i>(one fixture case)</i>"]

    subgraph DET1["Deterministic pre-checks &mdash; no LLM"]
        PRE["structured_prechecks.py<br/>malformed / duplicate / payment-claim shape"]
        SUS["instruction_detector.py<br/>is_suspicious() &mdash; adversarial-instruction pre-screen"]
    end

    subgraph ARM["Interpreter (exactly one arm per run)"]
        RULES["rules_interpreter.py<br/><i>baseline: 3 keyword classes</i>"]
        LLM["llm_interpreter.py<br/><i>Gemini flash-lite, frozen prompt</i>"]
    end

    BND["typed_boundary.py &mdash; AgentOutput<br/>signals + confidence + evidence_refs only<br/><i>no customer-text field is constructible</i>"]

    subgraph ENG["policy_engine.py &mdash; deterministic"]
        ROUTE["route() &middot; first-match precedence<br/>most-conservative-wins"]
    end

    VER["payment_verifier.py<br/>deterministic Razorpay status fetch<br/><i>model identifies evidence, Razorpay determines truth</i>"]
    DISP["link_dispatch.py<br/>quota guard (cap 28) + audit-log idempotency check"]
    RZP["razorpay_client.py &rarr; Razorpay Test Mode API<br/>create &middot; fetch status &middot; reconcile"]

    AUD[("audit_log.py<br/>hash-chained append-only<br/>POLICY_DECISION per case")]
    MET["metrics.py / generate_metrics.py<br/><i>offline: hard-stop matrix, divergence</i>"]

    STOP["STOP<br/>HARD_STOP"]
    PAUSE["PAUSE<br/>PAUSE_UNTIL_DATE"]
    REVIEW["REVIEW<br/>HUMAN_REVIEW"]
    RECOVER["RECOVER<br/>RECOVERY_ELIGIBLE"]

    IN --> PRE --> SUS --> RULES & LLM
    RULES --> BND
    LLM --> BND
    BND --> ROUTE
    ROUTE --> STOP
    ROUTE --> PAUSE
    ROUTE --> REVIEW
    ROUTE --> VER
    ROUTE --> RECOVER
    VER -.->|resolved status re-enters routing| ROUTE
    RECOVER --> DISP --> RZP
    ROUTE -.-> AUD
    DISP -.-> AUD
    RZP -.-> AUD
    AUD --> MET

